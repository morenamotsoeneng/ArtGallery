@model IEnumerable<ArtGallery.Models.ContactMessage>

@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Messages";
}

<section class="hero-section">

    <div class="container">

        <!-- Header -->

        <div class="hero-content text-center mb-5">

            <h1>
                Manage Messages
            </h1>

            <p>
                View and manage customer messages.
            </p>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4">

                @TempData["Success"]

            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="login-card h-100">

                            <div class="text-center mb-3">

                                <i class="bi bi-envelope-fill display-4 text-primary"></i>

                            </div>

                            <h3 class="text-center mb-3">

                                @item.Subject

                            </h3>

                            <hr />

                            <p>

                                <strong>Customer:</strong><br />

                                @(item.Customer != null ? item.Customer.FullName : "Unknown Customer")

                            </p>

                            <p>

                                <strong>Email:</strong><br />

                                @(item.Customer != null ? item.Customer.Email : "-")

                            </p>

                            <p>

                                <strong>Date:</strong><br />

                                @item.DateSent.ToString("dd MMM yyyy HH:mm")

                            </p>

                            <div class="d-grid gap-2 mt-4">

                                <a asp-action="Details"
                                   asp-route-id="@item.ContactMessageId"
                                   class="btn btn-dark">

                                    <i class="bi bi-eye-fill"></i>

                                    View

                                </a>

                                <a asp-action="Reply"
                                   asp-route-id="@item.ContactMessageId"
                                   class="btn btn-warning text-white">

                                    <i class="bi bi-reply-fill"></i>

                                    Reply

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.ContactMessageId"
                                   class="btn btn-danger"
                                   onclick="return confirm('Delete this message?');">

                                    <i class="bi bi-trash-fill"></i>

                                    Delete

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="login-card text-center">

                <i class="bi bi-envelope display-1 text-primary"></i>

                <h2 class="mt-4">

                    No Messages Found

                </h2>

                <p>

                    Customer messages will appear here after they submit the contact form.

                </p>

            </div>
        }

    </div>

</section>