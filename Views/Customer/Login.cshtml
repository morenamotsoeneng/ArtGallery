@model ArtGallery.ViewModels.CustomerLoginViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Customer Login";
}

<section class="hero-section">

    <div class="container">

        <div class="row justify-content-center align-items-center min-vh-100">

            <div class="col-lg-5 col-md-8">

                <div class="login-card">

                    <div class="text-center mb-4">

                        <i class="bi bi-person-circle display-4 text-warning"></i>

                        <h2 class="mt-3">
                            Welcome Back
                        </h2>

                        <p>
                            Sign in to continue exploring beautiful artwork.
                        </p>

                    </div>


                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }


                    <form asp-action="Login" method="post">

                        @Html.AntiForgeryToken()


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- EMAIL -->

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                            </label>


                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-envelope-fill"></i>
                                </span>


                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="Enter your email" />

                            </div>


                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>



                        <!-- PASSWORD -->

                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                            </label>


                            <div class="input-group">


                                <span class="input-group-text">

                                    <i class="bi bi-lock-fill"></i>

                                </span>



                                <input asp-for="Password"
                                       id="customerPassword"
                                       class="form-control"
                                       placeholder="Enter your password" />



                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        onclick="togglePassword('customerPassword',this)">


                                    <i class="bi bi-eye"></i>


                                </button>


                            </div>


                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>


                        </div>



                        <!-- OPTIONS -->


                        <div class="d-flex justify-content-between align-items-center mb-4">


                            <div class="form-check">


                                <input asp-for="RememberMe"
                                       class="form-check-input" />


                                <label asp-for="RememberMe"
                                       class="form-check-label">

                                    Remember Me

                                </label>


                            </div>



                            <a asp-controller="Customer"
                               asp-action="ForgotPassword"
                               class="text-warning fw-semibold text-decoration-none">

                                Forgot Password?

                            </a>


                        </div>




                        <button type="submit"
                                class="btn btn-dark w-100 py-3">


                            <i class="bi bi-box-arrow-in-right"></i>

                            Login


                        </button>



                    </form>



                    <hr />



                    <div class="text-center">


                        Don't have an account?


                        <a asp-action="Register"
                           class="text-warning fw-bold">


                            Create Account


                        </a>


                    </div>


                </div>


            </div>


        </div>


    </div>


</section>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>


        function togglePassword(id, btn) {


            var input = document.getElementById(id);

            var icon = btn.querySelector("i");



            if (input.type === "password") {


                input.type = "text";

                icon.className = "bi bi-eye-slash";


            }

            else {


                input.type = "password";

                icon.className = "bi bi-eye";


            }


        }


    </script>


}
