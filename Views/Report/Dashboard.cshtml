@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Reports Dashboard";
}

<section class="hero-section">

    <div class="container">

        <!-- Header -->

        <div class="hero-content text-center mb-5">

            <h1>
                Reports Dashboard
            </h1>

            <p>
                View gallery statistics, sales reports and recent customer orders.
            </p>

        </div>

        <!-- Dashboard Button -->

        <div class="login-card mb-5">

            <div class="d-flex justify-content-between align-items-center">

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="btn btn-dark">

                    <i class="bi bi-arrow-left-circle"></i>

                    Dashboard

                </a>

            </div>

        </div>

        <!-- Statistics -->

        <div class="row g-4 mb-5">

            <div class="col-lg-3 col-md-6">

                <div class="login-card text-center h-100">

                    <i class="bi bi-cash-stack text-success display-5 mb-3"></i>

                    <h5>Total Revenue</h5>

                    <h2>

                        R @(ViewBag.TotalRevenue != null
                          ? ((decimal)ViewBag.TotalRevenue).ToString("N2")
                          : "0.00")

                    </h2>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="login-card text-center h-100">

                    <i class="bi bi-bag-check-fill text-primary display-5 mb-3"></i>

                    <h5>Total Orders</h5>

                    <h2>

                        @(ViewBag.TotalOrders ?? 0)

                    </h2>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="login-card text-center h-100">

                    <i class="bi bi-people-fill text-info display-5 mb-3"></i>

                    <h5>Total Customers</h5>

                    <h2>

                        @(ViewBag.TotalCustomers ?? 0)

                    </h2>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="login-card text-center h-100">

                    <i class="bi bi-palette-fill text-warning display-5 mb-3"></i>

                    <h5>Artworks Sold</h5>

                    <h2>

                        @(ViewBag.TotalArtworksSold ?? 0)

                    </h2>

                </div>

            </div>

        </div>

        <!-- Best Selling Artwork -->

        <div class="login-card mb-5">

            <h3 class="mb-4">

                <i class="bi bi-trophy-fill text-warning"></i>

                Best Selling Artwork

            </h3>

            @if (ViewBag.BestSellingArtwork != null)
            {
                <div class="text-center py-4">

                    <i class="bi bi-award-fill text-warning display-2 mb-3"></i>

                    <h2>

                        @ViewBag.BestSellingArtwork

                    </h2>

                    <p class="fs-5 mb-0">

                        Sold

                        <strong>

                            @ViewBag.BestSellingCount

                        </strong>

                        time(s)

                    </p>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-palette display-1 text-muted"></i>

                    <h3 class="mt-3">

                        No Artwork Sales Yet

                    </h3>

                    <p>

                        Sales statistics will appear here once customers begin purchasing artworks.

                    </p>

                </div>
            }

        </div>

        <!-- Recent Orders -->

        <div class="login-card">

            <h3 class="mb-4">

                <i class="bi bi-clock-history"></i>

                Recent Orders

            </h3>

            @if (ViewBag.RecentOrders != null)
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>Order #</th>

                                <th>Customer</th>

                                <th>Date</th>

                                <th class="text-end">Total</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in ViewBag.RecentOrders)
                            {
                                <tr>

                                    <td>

                                        @order.OrderId

                                    </td>

                                    <td>

                                        @order.Customer?.FullName

                                    </td>

                                    <td>

                                        @order.OrderDate.ToString("dd MMM yyyy")

                                    </td>

                                    <td class="text-end">

                                        <strong>

                                            R @order.TotalAmount.ToString("N2")

                                        </strong>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-receipt display-1 text-muted"></i>

                    <h3 class="mt-3">

                        No Recent Orders

                    </h3>

                    <p>

                        Recent customer orders will appear here.

                    </p>

                </div>
            }

        </div>

    </div>

</section>
