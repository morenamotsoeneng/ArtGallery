@{
    ViewData["Title"] = "Welcome";
}

<!-- ================= HERO ================= -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center">

            <!-- LEFT -->

            <div class="col-lg-7">

                <div class="hero-content text-lg-start text-center">

                    <h1>
                        Discover Timeless Art
                    </h1>

                    <h3>
                        Where Creativity Meets Elegance
                    </h3>

                    <p>
                        Explore unique paintings, sculptures and contemporary
                        masterpieces created by talented artists. Find artwork
                        that inspires your space and tells a story.
                    </p>

                </div>

            </div>

            <!-- RIGHT -->

            <div class="col-lg-5 mt-5 mt-lg-0">

                <div class="login-card">

                    <h2 class="text-center mb-4">

                        Welcome

                    </h2>

                    <p class="text-center mb-4">

                        Choose how you would like to continue.

                    </p>

                    <select id="heroLoginRole"
                            class="form-select mb-4">

                        <option value="">
                            Select Login Type
                        </option>

                        <option value="customer">
                            Customer
                        </option>

                        <option value="admin">
                            Administrator
                        </option>

                    </select>

                    <button class="btn btn-dark w-100"
                            onclick="heroLogin()">

                        <i class="bi bi-box-arrow-in-right"></i>

                        Continue

                    </button>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ================= WHY CHOOSE US ================= -->

<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2>Why Choose Our Gallery?</h2>

            <p>
                Experience quality, creativity and trusted service.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="card text-center p-4 h-100">

                    <i class="bi bi-palette-fill fs-1 text-warning"></i>

                    <h4 class="mt-3">
                        Original Art
                    </h4>

                    <p>
                        Carefully selected artwork from talented artists.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card text-center p-4 h-100">

                    <i class="bi bi-shield-check fs-1 text-warning"></i>

                    <h4 class="mt-3">
                        Secure Shopping
                    </h4>

                    <p>
                        Safe checkout and reliable order management.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card text-center p-4 h-100">

                    <i class="bi bi-star-fill fs-1 text-warning"></i>

                    <h4 class="mt-3">
                        Trusted Quality
                    </h4>

                    <p>
                        Every artwork is presented with care and professionalism.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ================= CALL TO ACTION ================= -->

<section class="py-5 bg-dark text-white">

    <div class="container text-center">

        <h2>

            Begin Your Art Journey

        </h2>

        <p class="mb-4">

            Sign in to explore beautiful artwork, manage your favourites,
            purchase original pieces and connect with our gallery.

        </p>

        <button class="btn btn-light px-5"
                onclick="heroLogin()">

            Login Now

        </button>

    </div>

</section>

@section Scripts {

    <script>

        function heroLogin() {

            var role = document.getElementById("heroLoginRole").value;

            if (role === "customer") {

                window.location = "/Customer/Login";

            }

            else if (role === "admin") {

                window.location = "/Admin/Login";

            }

            else {

                alert("Please select a login type.");

            }

        }

    </script>

}







