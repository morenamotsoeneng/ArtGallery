@model ArtGallery.Models.Category

@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Category";
}

<section class="dashboard-page">

    <div class="container">

        <!-- Header -->

        <div class="dashboard-header text-center mb-5">

            <h1>
                Delete Category
            </h1>

            <p>
                Review the category details before permanently deleting it.
            </p>

        </div>

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="login-card">

                    <!-- Warning -->

                    <div class="alert alert-danger text-center mb-5">

                        <i class="bi bi-exclamation-triangle-fill fs-1"></i>

                        <h4 class="mt-3">
                            Warning!
                        </h4>

                        <p class="mb-0">
                            This action cannot be undone.
                        </p>

                    </div>

                    <div class="row align-items-center g-5">

                        <!-- Category Icon -->

                        <div class="col-lg-4 text-center">

                            <i class="bi bi-folder-fill text-primary"
                               style="font-size:140px;"></i>

                        </div>

                        <!-- Category Details -->

                        <div class="col-lg-8">

                            <table class="table details-table align-middle">

                                <tbody>

                                    <tr>

                                        <th>
                                            <i class="bi bi-hash"></i>
                                            Category ID
                                        </th>

                                        <td>
                                            @Model.CategoryId
                                        </td>

                                    </tr>

                                    <tr>

                                        <th>
                                            <i class="bi bi-folder-fill"></i>
                                            Category Name
                                        </th>

                                        <td>
                                            @Model.CategoryName
                                        </td>

                                    </tr>

                                    <tr>

                                        <th>
                                            <i class="bi bi-card-text"></i>
                                            Description
                                        </th>

                                        <td>
                                            @Model.Description
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                    <!-- Buttons -->

                    <form asp-action="Delete"
                          method="post"
                          class="mt-5">

                        <input type="hidden" asp-for="CategoryId" />

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                            <a asp-action="Index"
                               class="btn btn-dashboard-action">

                                <i class="bi bi-arrow-left-circle"></i>

                                Back

                            </a>

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-trash-fill"></i>

                                Delete Category

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>
