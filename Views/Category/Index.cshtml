@model IEnumerable<ArtGallery.Models.Category>

@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Categories";
}

<section class="hero-section">

    <div class="container">

        <!-- Header -->

        <div class="hero-content text-center mb-5">

            <h1>
                Category Management
            </h1>

            <p>
                Organize and manage your artwork categories.
            </p>

        </div>

        <!-- Top Buttons -->

        <div class="login-card mb-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="btn btn-dark">

                    <i class="bi bi-arrow-left-circle"></i>

                    Dashboard

                </a>

                <a asp-action="Create"
                   class="btn btn-dark">

                    <i class="bi bi-plus-circle-fill"></i>

                    Add Category

                </a>

            </div>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="login-card h-100 text-center">

                            <div class="py-4">

                                <i class="bi bi-folder-fill text-primary"
                                   style="font-size:70px;"></i>

                            </div>

                            <div>

                                <h3 class="mb-3">
                                    @item.CategoryName
                                </h3>

                                <p>
                                    @item.Description
                                </p>

                                <hr />

                                <div class="d-grid gap-2 mt-3">

                                    <a asp-action="Details"
                                       asp-route-id="@item.CategoryId"
                                       class="btn btn-dark">

                                        <i class="bi bi-eye-fill"></i>

                                        Details

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.CategoryId"
                                       class="btn btn-warning text-white">

                                        <i class="bi bi-pencil-square"></i>

                                        Edit

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.CategoryId"
                                       class="btn btn-danger">

                                        <i class="bi bi-trash-fill"></i>

                                        Delete

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="login-card text-center">

                <i class="bi bi-folder-x display-1 text-primary"></i>

                <h2 class="mt-4">
                    No Categories Found
                </h2>

                <p>
                    Your gallery doesn't have any categories yet.
                </p>

                <a asp-action="Create"
                   class="btn btn-dark mt-3">

                    <i class="bi bi-plus-circle-fill"></i>

                    Add Your First Category

                </a>

            </div>
        }

    </div>

</section>


