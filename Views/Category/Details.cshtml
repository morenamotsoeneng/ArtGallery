@model ArtGallery.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<section class="hero-section">

    <div class="container">

        <div class="hero-content text-center mb-5">

            <h1>Category Details</h1>

            <p>View complete information about this category.</p>

        </div>

        <div class="login-card">

            <div class="row align-items-center g-5">

                <div class="col-lg-4 text-center">

                    <i class="bi bi-folder-fill text-warning"
                       style="font-size:140px;"></i>

                </div>

                <div class="col-lg-8">

                    <table class="table details-table align-middle">

                        <tbody>

                            <tr>

                                <th>
                                    <i class="bi bi-hash"></i>
                                    Category ID
                                </th>

                                <td>
                                    @Model.CategoryId
                                </td>

                            </tr>

                            <tr>

                                <th>
                                    <i class="bi bi-folder-fill"></i>
                                    Category Name
                                </th>

                                <td>
                                    @Model.CategoryName
                                </td>

                            </tr>

                            <tr>

                                <th>
                                    <i class="bi bi-card-text"></i>
                                    Description
                                </th>

                                <td>
                                    @Model.Description
                                </td>

                            </tr>

                        </tbody>

                    </table>

                    <div class="d-flex justify-content-between flex-wrap gap-3 mt-4">

                        <a asp-action="Index"
                           class="btn btn-dark">

                            <i class="bi bi-arrow-left-circle"></i>

                            Back

                        </a>

                        <div>

                            <a asp-action="Edit"
                               asp-route-id="@Model.CategoryId"
                               class="btn btn-warning text-white me-2">

                                <i class="bi bi-pencil-square"></i>

                                Edit

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@Model.CategoryId"
                               class="btn btn-danger">

                                <i class="bi bi-trash-fill"></i>

                                Delete

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
