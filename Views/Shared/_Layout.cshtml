@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Art Gallery</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ArtGallery.styles.css"
          asp-append-version="true" />

</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header>

        <nav class="navbar navbar-expand-lg guest-navbar">

            <div class="container">

                <a class="navbar-brand p-0 m-0" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png?v=5"
                         alt="Logo"
                         style="height:150px; width:auto; max-width:none; " />
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse justify-content-end"
                     id="navbarNav">

                    <div class="d-flex align-items-center gap-2">

                        <select id="loginRole"
                                class="form-select">

                            <option value="">
                                Login As
                            </option>

                            <option value="customer">
                                Customer
                            </option>

                            <option value="admin">
                                Admin
                            </option>

                        </select>

                        <button type="button"
                                class="btn btn-dark px-4"
                                onclick="redirectLogin()">

                            <i class="bi bi-box-arrow-in-right"></i>

                            Login

                        </button>

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <!-- ================= CONTENT ================= -->

    <main>

        @RenderBody()

    </main>

    <!-- ================= FOOTER ================= -->

    <footer class="guest-footer">

        <div class="container">

            <div class="row">

                <div class="col-md-6">

                    <h4>Art Gallery</h4>

                    <p>
                        Discover timeless masterpieces from talented artists
                        around the world.
                    </p>

                </div>

                <div class="col-md-3">

                    <h5>Explore</h5>

                    <ul class="list-unstyled">

                        <li>

                            <a asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Home"
                               asp-action="Privacy">

                                About

                            </a>

                        </li>

                    </ul>

                </div>

                <div class="col-md-3">

                    <h5>Follow Us</h5>

                    <div class="social-icons">

                        <a href="#">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                    </div>

                </div>

            </div>

            <hr />

            <p class="text-center mb-0">

                © @DateTime.Now.Year Art Gallery

            </p>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script>

        function redirectLogin() {

            let role = document.getElementById("loginRole").value;

            if (role === "customer") {

                window.location.href = "/Customer/Login";

            }

            else if (role === "admin") {

                window.location.href = "/Admin/Login";

            }

            else {

                alert("Please select a login role.");

            }

        }

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>