@model ArtGallery.Models.ArtWork

@{
    ViewData["Title"] = "Artwork Details";
}

<section class="hero-section">

    <div class="container">

        <!-- Page Header -->

        <div class="hero-content text-center mb-5">

            <h1>
                Artwork Details
            </h1>

            <p>
                View complete information about this artwork.
            </p>

        </div>

        <!-- White Card -->

        <div class="login-card">

            <div class="row align-items-center g-5">

                <!-- Artwork Image -->

                <div class="col-lg-4 text-center">

                    <img src="@Model.ImageURL"
                         class="details-image img-fluid rounded-4 shadow"
                         alt="@Model.Title" />

                </div>

                <!-- Artwork Information -->

                <div class="col-lg-8">

                    <table class="table details-table align-middle">

                        <tbody>

                            <tr>

                                <th>
                                    <i class="bi bi-hash"></i>
                                    Artwork ID
                                </th>

                                <td>
                                    @Model.ArtId
                                </td>

                            </tr>

                            <tr>

                                <th>
                                    <i class="bi bi-brush"></i>
                                    Title
                                </th>

                                <td>
                                    @Model.Title
                                </td>

                            </tr>

                            <tr>

                                <th>
                                    <i class="bi bi-person-fill"></i>
                                    Artist
                                </th>

                                <td>
                                    @Model.ArtistName
                                </td>

                            </tr>

                            <tr>

                                <th>
                                    <i class="bi bi-cash-stack"></i>
                                    Price
                                </th>

                                <td>
                                    R @Model.Price
                                </td>

                            </tr>

                            <tr>

                                <th>
                                    <i class="bi bi-card-text"></i>
                                    Description
                                </th>

                                <td>
                                    @Model.Description
                                </td>

                            </tr>

                            <tr>

                                <th>
                                    <i class="bi bi-check-circle-fill"></i>
                                    Status
                                </th>

                                <td>

                                    @if (Model.Status)
                                    {
                                        <span class="badge bg-success px-3 py-2">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2">
                                            Sold
                                        </span>
                                    }

                                </td>

                            </tr>

                            <tr>

                                <th>
                                    <i class="bi bi-image-fill"></i>
                                    Image Path
                                </th>

                                <td class="text-break">
                                    @Model.ImageURL
                                </td>

                            </tr>

                        </tbody>

                    </table>

                    <!-- Buttons -->

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4">

                        <a asp-action="Index"
                           class="btn btn-dark">

                            <i class="bi bi-arrow-left-circle"></i>

                            Back to List

                        </a>

                        <div>

                            <a asp-action="Edit"
                               asp-route-id="@Model.ArtId"
                               class="btn btn-warning text-white me-2">

                                <i class="bi bi-pencil-square"></i>

                                Edit Artwork

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@Model.ArtId"
                               class="btn btn-danger">

                                <i class="bi bi-trash-fill"></i>

                                Delete

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
