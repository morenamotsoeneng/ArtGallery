@model ArtGallery.Models.Order

@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Order Details";
}

<section class="dashboard-page">

    <div class="container">

        <!-- Header -->

        <div class="dashboard-header text-center mb-5">

            <h1>
                Order Details
            </h1>

            <p>
                View complete information about this customer order.
            </p>

        </div>

        <div class="row justify-content-center">

            <div class="col-lg-10">

                <div class="login-card">

                    <div class="row align-items-center g-5">

                        <!-- Left Side -->

                        <div class="col-lg-4 text-center">

                            <div class="d-flex justify-content-center align-items-center h-100">

                                <i class="bi bi-receipt-cutoff text-primary"
                                   style="font-size:180px;"></i>

                            </div>

                        </div>

                        <!-- Right Side -->

                        <div class="col-lg-8">

                            <table class="table details-table align-middle">

                                <tbody>

                                    <tr>
                                        <th>
                                            <i class="bi bi-hash"></i>
                                            Order ID
                                        </th>
                                        <td>@Model.OrderId</td>
                                    </tr>

                                    <tr>
                                        <th>
                                            <i class="bi bi-person-fill"></i>
                                            Customer
                                        </th>
                                        <td>@Model.Customer?.FullName</td>
                                    </tr>

                                    <tr>
                                        <th>
                                            <i class="bi bi-envelope-fill"></i>
                                            Email
                                        </th>
                                        <td>@Model.Customer?.Email</td>
                                    </tr>

                                    <tr>
                                        <th>
                                            <i class="bi bi-calendar-event"></i>
                                            Order Date
                                        </th>
                                        <td>@Model.OrderDate.ToString("dd MMM yyyy")</td>
                                    </tr>

                                    <tr>
                                        <th>
                                            <i class="bi bi-cash-stack"></i>
                                            Total Amount
                                        </th>
                                        <td>
                                            <strong>
                                                R @Model.TotalAmount.ToString("N2")
                                            </strong>
                                        </td>
                                    </tr>

                                    <tr>

                                        <th>
                                            <i class="bi bi-check-circle-fill"></i>
                                            Status
                                        </th>

                                        <td>

                                            @if (Model.Status == "Completed")
                                            {
                                                <span class="badge bg-success px-3 py-2">
                                                    @Model.Status
                                                </span>
                                            }
                                            else if (Model.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark px-3 py-2">
                                                    @Model.Status
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary px-3 py-2">
                                                    @Model.Status
                                                </span>
                                            }

                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                    <hr class="my-5" />

                    <!-- Ordered Artworks -->

                    <h3 class="mb-4">
                        <i class="bi bi-palette-fill"></i>
                        Ordered Artworks
                    </h3>

                    <table class="table details-table align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Artwork
                                </th>

                                <th class="text-end">
                                    Price
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.OrderItems!)
                            {
                                <tr>

                                    <td>
                                        @item.ArtWork?.Title
                                    </td>

                                    <td class="text-end">
                                        R @item.Price.ToString("N2")
                                    </td>

                                </tr>
                            }

                        </tbody>

                        <tfoot>

                            <tr>

                                <th>
                                    Total
                                </th>

                                <th class="text-end text-success">

                                    R @Model.TotalAmount.ToString("N2")

                                </th>

                            </tr>

                        </tfoot>

                    </table>

                    <!-- Buttons -->

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-5">

                        <a asp-action="Index"
                           class="btn btn-dashboard-action">

                            <i class="bi bi-arrow-left-circle"></i>

                            Back to Orders

                        </a>

                        <a asp-controller="Admin"
                           asp-action="Dashboard"
                           class="btn btn-dark">

                            <i class="bi bi-speedometer2"></i>

                            Dashboard

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>